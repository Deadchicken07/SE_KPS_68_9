generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addresses {
  id              Int            @id @default(autoincrement())
  province_id     Int?
  district_id     Int?
  sub_district_id Int?
  zip_code_id     Int?
  detail          String?        @db.VarChar(255)
  district        districts?     @relation(fields: [district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  province        provinces?     @relation(fields: [province_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subDistrict     sub_districts? @relation(fields: [sub_district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  zipCode         zip_codes?     @relation(fields: [zip_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nationUsers     users[]        @relation("NationAddress")
  currentUsers    users[]        @relation("CurrentAddress")
}

model answers {
  id          Int        @id @default(autoincrement())
  response_id Int?
  question_id Int?
  choice_id   Int?
  choice      choices?   @relation(fields: [choice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  question    questions? @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  response    responses? @relation(fields: [response_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model appointments {
  id                Int                     @id @default(autoincrement())
  user_id           Int?
  staff_id          Int?
  appointment_type  appointments_type_enum?
  appointment_date  DateTime?               @db.Date
  status            pay_type_enum?          @default(Not_paying)
  time_select       String?                 @db.VarChar(255)
  deposit_slip_file String?                 @db.VarChar(255)
  staff             users?                  @relation("StaffAppointments", fields: [staff_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  patient           users?                  @relation("PatientAppointments", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model choices {
  id          Int        @id @default(autoincrement())
  question_id Int?
  choice_text String?    @db.VarChar(255)
  weight      Int?
  answers     answers[]
  question    questions? @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model consultations {
  id                 Int                  @id @default(autoincrement())
  user_id            Int?
  staff_id           Int?
  pharmacist_id      Int?
  note               String?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  pharmacist         users?               @relation("PharmacistConsultations", fields: [pharmacist_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  staff              users?               @relation("StaffConsultations", fields: [staff_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  patient            users?               @relation("PatientConsultations", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  prescription_items prescription_items[]
  receipts           receipts[]
}

model districts {
  id            Int             @id @default(autoincrement())
  name          String?         @db.VarChar(255)
  province_id   Int?
  addresses     addresses[]
  province      provinces?      @relation(fields: [province_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sub_districts sub_districts[]
}

model fees {
  id              Int       @id @default(autoincrement())
  price_per_hours Decimal?  @db.Decimal(10, 2)
  created_at      DateTime? @db.Date
}

model medications {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(255)
  retail             Decimal?             @db.Decimal(10, 2)
  price              Decimal?             @db.Decimal(10, 2)
  prescription_items prescription_items[]
  receipt_details    receipt_details[]
}

model prescription_items {
  id              Int            @id @default(autoincrement())
  consultation_id Int?
  medication_id   Int?
  comment         String?        @db.VarChar(100)
  quantity        Int?
  consultation    consultations? @relation(fields: [consultation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medication      medications?   @relation(fields: [medication_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model provinces {
  id        Int         @id @default(autoincrement())
  name      String?     @db.VarChar(255)
  addresses addresses[]
  districts districts[]
}

model questionnaires {
  id         Int                       @id @default(autoincrement())
  title      String?                   @db.VarChar(255)
  status     questionnaires_type_enum? @default(show)
  created_at DateTime?                 @default(now()) @db.Timestamp(6)
  questions  questions[]
  responses  responses[]
}

model questions {
  id               Int             @id @default(autoincrement())
  questionnaire_id Int?
  question_text    String?         @db.VarChar(255)
  answers          answers[]
  choices          choices[]
  questionnaire    questionnaires? @relation(fields: [questionnaire_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model receipt_details {
  id             Int             @id @default(autoincrement())
  receipt_id     Int
  item_name      String?         @db.VarChar(255)
  item_type      item_type_enum?
  medicine_id    Int?
  medicine_price Decimal?        @db.Decimal(10, 2)
  quantity       Int?
  unit_price     Decimal?        @db.Decimal(10, 2)
  total_price    Decimal?        @db.Decimal(10, 2)
  medication     medications?    @relation(fields: [medicine_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_medicine")
  receipt        receipts        @relation(fields: [receipt_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_receipt")
}

model receipts {
  id              Int               @id @default(autoincrement())
  consultation_id Int?
  user_id         Int?
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  slip_file       String?           @db.VarChar(255)
  total           Decimal?          @db.Decimal(10, 2)
  tracking        String?           @db.VarChar(255)
  status          String?
  receipt_details receipt_details[]
  consultation    consultations?    @relation(fields: [consultation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            users?            @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model responses {
  id               Int             @id @default(autoincrement())
  questionnaire_id Int?
  user_id          Int?
  submitted_at     DateTime?       @db.Date
  answers          answers[]
  questionnaire    questionnaires? @relation(fields: [questionnaire_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             users?          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model roles {
  id     Int     @id @default(autoincrement())
  name   String? @db.VarChar(255)
  fee_id Int?
  users  users[]
}

model schedule {
  id         Int              @id @default(autoincrement())
  staff_id   Int
  work_date  DateTime         @db.Date
  status     schedule_status? @default(working)
  note       String?          @db.VarChar(255)
  created_at DateTime?        @default(now()) @db.Timestamp(6)
  staff      users            @relation(fields: [staff_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([staff_id, work_date])
}

model sub_districts {
  id          Int         @id @default(autoincrement())
  name        String?     @db.VarChar(255)
  district_id Int?
  addresses   addresses[]
  district    districts?  @relation(fields: [district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  zip_codes   zip_codes[]
}

model time_slots {
  id         Int    @id @default(autoincrement())
  time_label String @db.VarChar(255)
}

model users {
  user_id                 Int             @id @default(autoincrement())
  created_by              Int?
  role_id                 Int?
  email                   String?         @unique @db.VarChar(255)
  name                    String          @db.VarChar(255)
  sur_name                String          @db.VarChar(255)
  phone                   String?         @db.VarChar(20)
  nation_id               String?         @unique @db.VarChar(255)
  address_id              Int?
  medical_condition       String?         @db.VarChar(255)
  allergy_drug            String?         @db.VarChar(255)
  password_hash           String?         @db.VarChar(255)
  created_at              DateTime?       @default(now()) @db.Timestamp(6)
  file_name               String?
  info                    String?         @db.VarChar(255)
  degree                  String?         @db.VarChar(255)
  license                 String?         @db.VarChar(255)
  status                  String?         @db.VarChar(255)
  address_id_nation       Int?
  title                   String?         @db.VarChar
  staffAppointments       appointments[]  @relation("StaffAppointments")
  patientAppointments     appointments[]  @relation("PatientAppointments")
  pharmacistConsultations consultations[] @relation("PharmacistConsultations")
  staffConsultations      consultations[] @relation("StaffConsultations")
  patientConsultations    consultations[] @relation("PatientConsultations")
  receipts                receipts[]
  responses               responses[]
  schedule                schedule[]
  nationAddress           addresses?      @relation("NationAddress", fields: [address_id_nation], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_address_nation")
  currentAddress          addresses?      @relation("CurrentAddress", fields: [address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy               users?          @relation("UserCreator", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  createdUsers            users[]         @relation("UserCreator")
  role                    roles?          @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model zip_codes {
  id              Int            @id @default(autoincrement())
  code            String?        @db.VarChar(20)
  sub_district_id Int?
  addresses       addresses[]
  subDistrict     sub_districts? @relation(fields: [sub_district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum appointments_type_enum {
  online
  onsite
}

enum item_type_enum {
  medicine
  service
  lab
  fee
}

enum pay_type_enum {
  Paid
  Not_paying @map("Not paying")
}

enum questionnaires_type_enum {
  show
  hidden
}

enum schedule_status {
  working
  leave
}
